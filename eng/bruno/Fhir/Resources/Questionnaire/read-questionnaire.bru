meta {
  name: Read Questionnaire
  type: http
  seq: 3
}

get {
  url: {{fhirBase}}/Questionnaire/{{questionnaireId}}
  body: none
  auth: inherit
}

assert {
  res.status: eq 200
  res.body.resourceType: eq Questionnaire
}

docs {
  Needs `questionnaireId`. Expect `200` with `meta.versionId` and an `ETag` header.
}
