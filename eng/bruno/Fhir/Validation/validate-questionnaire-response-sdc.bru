meta {
  name: Validate QuestionnaireResponse (SDC)
  type: http
  seq: 8
}

post {
  url: {{fhirBase}}/QuestionnaireResponse/$validate?profile=http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaireresponse
  body: json
  auth: inherit
}

params:query {
  profile: http://hl7.org/fhir/uv/sdc/StructureDefinition/sdc-questionnaireresponse
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "QuestionnaireResponse",
    "questionnaire": "http://example.org/Questionnaire/meds",
    "status": "completed",
    "subject": { "display": "Test patient" },
    "authored": "2026-11-02T21:00:00+01:00",
    "item": [
      {
        "linkId": "meds",
        "item": [{ "linkId": "drug", "answer": [{ "valueString": "Paracetamol" }] }]
      },
      {
        "linkId": "meds",
        "item": [
          { "linkId": "drug", "answer": [{ "valueString": "Ibuprofen" }] },
          {
            "linkId": "prn",
            "answer": [
              { "valueBoolean": true, "item": [{ "linkId": "prn-reason", "answer": [{ "valueString": "Pain" }] }] }
            ]
          }
        ]
      }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.resourceType: eq OperationOutcome
}

tests {
  test("has no errors or warnings", function () {
    const issues = (res.getBody().issue || []).filter((issue) => ["fatal", "error", "warning"].includes(issue.severity));
    expect(issues).to.have.length(0);
  });
}

docs {
  A repeating group as two items with the same linkId, and a question's child under its answer
  (qrs-1). Valid against SDC. Needs `hl7.fhir.uv.sdc` loaded.
}
