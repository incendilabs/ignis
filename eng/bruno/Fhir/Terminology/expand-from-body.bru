meta {
  name: Expand ValueSet from body
  type: http
  seq: 2
}

post {
  url: {{fhirBase}}/ValueSet/$expand
  body: json
  auth: inherit
}

headers {
  Content-Type: application/fhir+json
}

body:json {
  {
    "resourceType": "Parameters",
    "parameter": [
      { "name": "url", "valueUri": "http://hl7.org/fhir/ValueSet/administrative-gender" },
      { "name": "filter", "valueString": "fem" }
    ]
  }
}

assert {
  res.status: eq 200
  res.body.resourceType: eq ValueSet
  res.body.expansion.total: eq 1
  res.body.expansion.contains: length 1
  res.body.expansion.contains[0].code: eq female
  res.body.expansion.parameter[0].name: eq filter
}

docs {
  Same operation via a `Parameters` body, which also accepts an inline `valueSet`. The
  `filter` matches code or display, ignoring case; the expansion echoes it in `parameter`.
}
