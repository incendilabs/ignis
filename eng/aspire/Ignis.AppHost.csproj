<Project Sdk="Aspire.AppHost.Sdk/13.6.3">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UserSecretsId>ignis-apphost</UserSecretsId>
        <!-- Orchestrator from NuGet, so plain `dotnet run` and CI work without the Aspire CLI. -->
        <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Aspire.Hosting.JavaScript" Version="13.6.3" />
        <PackageReference Include="Aspire.Hosting.MongoDB" Version="13.6.3" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Ignis.Api/Ignis.Api.csproj" />
    </ItemGroup>
</Project>
