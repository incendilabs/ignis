<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="4.0.1" />
        <PackageReference Include="FluentAssertions" Version="8.11.0" />
    </ItemGroup>
    <ItemGroup>
        <Using Include="Xunit" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="../../src/Ignis.Codegen/Ignis.Codegen.csproj" />
    </ItemGroup>

    <!-- Stages hl7.fhir.r4.core into bin/fhir-packages, like the other test projects. -->
    <Import Project="../../fhir-packages.targets" />
</Project>
