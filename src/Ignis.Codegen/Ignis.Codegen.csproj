<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>Ignis.Codegen</RootNamespace>
        <!-- Downloads one core package per FHIR version into fhir-packages/<version>/ (see fhir-packages.targets). -->
        <FhirCodegenPackages>true</FhirCodegenPackages>
        <NoWarn>$(NoWarn);ExperimentalApi;SDK0001</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Firely.Fhir.Packages" Version="6.1.0" />
        <PackageReference Include="Hl7.Fhir.Conformance" Version="6.6.0" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Ignis.Codegen.Tests" />
    </ItemGroup>

    <Import Project="../../fhir-packages.targets" />

</Project>
