<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- NU1510: the direct System.Security.Cryptography.Xml reference below is intentional. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1510</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenIddict.AspNetCore" Version="7.7.1" />
    <PackageReference Include="OpenIddict.MongoDb" Version="7.7.1" />
    <!--
    Updating MongoDB.Driver to 3.9.0 resolves the vulnerable transitive dependencies SharpCompress and Snappier.
    When OpenIddict.MongoDb resolves this upstream we can remove this package again.
     -->
    <PackageReference Include="MongoDB.Driver" Version="3.12.0" />
    <!--
    Transitive dependency System.Security.Cryptography.Xml has vulnerabilties, reference it directly until this is
    resolved in OpenIddict packages.
     -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Ignis.Api.Tests" />
  </ItemGroup>

</Project>
