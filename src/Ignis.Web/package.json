{
  "name": "ignis-web",
  "private": true,
  "type": "module",
  "imports": {
    "#app/*": "./app/*"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "docs:collect": "node --input-type=module -e \"const { runCollect } = await import('@eventuras/lectio-docs'); await runCollect()\"",
    "lint": "npm run paraglide:compile && react-router typegen && eslint .",
    "paraglide:compile": "paraglide-js compile --project ./app/i18n/project.inlang --outdir ./app/i18n/paraglide --emit-ts-declarations --strategy url cookie preferredLanguage baseLocale",
    "start": "react-router-serve ./build/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run paraglide:compile && react-router typegen && tsc"
  },
  "dependencies": {
    "@eventuras/fides-auth": "^0.14.0",
    "@eventuras/lectio-docs": "^0.6.0",
    "@eventuras/logger": "^0.8.1",
    "@eventuras/markdown": "^0.15.1",
    "@eventuras/ratio-ui": "^2.23.0",
    "@microsoft/signalr": "^10.0.11",
    "@react-router/node": "8.3.1",
    "@react-router/serve": "8.3.1",
    "isbot": "^5.2.2",
    "react": "^19.2.8",
    "react-aria-components": "^1.21.0",
    "react-dom": "^19.2.8",
    "react-router": "8.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@inlang/paraglide-js": "^2.25.0",
    "@inlang/plugin-m-function-matcher": "^2.2.13",
    "@inlang/plugin-message-format": "^4.4.4",
    "@react-router/dev": "8.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "eslint": "^10.9.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
